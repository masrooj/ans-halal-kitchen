# Server/build only — do not expose in the browser bundle.
# Enable Places API on your GCP project (billing required), then download listing photos:
#   GOOGLE_MAPS_API_KEY=your_key_here npm run fetch:maps-photos
GOOGLE_MAPS_API_KEY=

# Optional — override Places `place_id` (must match listings you own / have API access for)
GOOGLE_PLACE_ID=

# Stock food/venue images (no key): committed under public/images after you run:
#   npm run download:stock-images
